# Copy this file to `.env` (which is gitignored — never commit it) to
# override machine-specific or secret-shaped values without editing
# config/*.yaml. Every variable below is optional; Echoface works with
# none of them set, using the defaults in config/echoface.yaml.
#
# Loaded automatically at CLI startup via echoface/util/env.py
# (python-dotenv), only if a .env file exists in the current directory.

# --- Ollama (script stage) ---------------------------------------------
# Overrides script.host / script.model from config/echoface.yaml. Useful
# if Ollama runs on a different host/port, or in a container.
# ECHOFACE_OLLAMA_HOST=http://localhost:11434
# ECHOFACE_OLLAMA_MODEL=qwen2.5:7b

# --- Piper (voice stage) ------------------------------------------------
# Overrides voice.piper_exe / voice.piper_model.
# ECHOFACE_PIPER_EXE=envs/tts/Scripts/piper.exe
# ECHOFACE_PIPER_MODEL=models/piper/en_US-lessac-medium.onnx

# --- ffmpeg ---------------------------------------------------------------
# Set if ffmpeg/ffprobe aren't on PATH. Point either at the folder
# containing ffmpeg.exe/ffprobe.exe, or directly at ffmpeg.exe (ffprobe is
# then assumed to sit next to it).
# ECHOFACE_FFMPEG_PATH=C:\ffmpeg\bin

# --- Hugging Face Hub (faster-whisper, XTTS v2 model downloads) --------
# Only needed for gated/rate-limited models or private repos; public
# models (Systran/faster-whisper-*, coqui/XTTS-v2) download without one.
# Read automatically by huggingface_hub — no echoface-specific code needed.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- XTTS v2 licence acknowledgement (voice.engine: xtts, M8) ----------
# XTTS v2's weights are Coqui Public Model License (CPML) — NON-COMMERCIAL.
# scripts/xtts_runner.py sets this to "1" by default (selecting
# voice.engine: xtts in config is itself the opt-in), but you can set it
# explicitly here if you prefer that to be visible in your environment.
# COQUI_TOS_AGREED=1
